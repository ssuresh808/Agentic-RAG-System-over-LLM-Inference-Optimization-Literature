# Cloud deployment config - Render + Qdrant Cloud + hosted inference.
# Copy values into the Render dashboard (or a local .env to simulate cloud mode).
# Never commit real secrets; .env is gitignored.

# --- Hosted inference: unplugs the local Ollama + torch stack ---------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Alternative hosted LLM (Anthropic):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=
#
# A hosted Qwen endpoint works via any OpenAI-compatible gateway
# (LLM_PROVIDER=openai pointed at that gateway).

# --- Qdrant Cloud: remote vector DB (overrides local .qdrant_storage) -------
# When QDRANT_CLOUD_URL and QDRANT_API_KEY are both set, the engine connects to
# the remote cluster; otherwise it falls back to the local persistent volume.
QDRANT_CLOUD_URL=https://xyz-example.region.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=llm_optimization_domain

# --- Agent path -------------------------------------------------------------
GENERATION_MODE=agent

# --- Abuse protection (src/api/rate_limit.py) -------------------------------
# The /api/v1/query and /api/v1/answer endpoints each spend money per call, so
# the public backend is guarded. RAG_API_KEY is a shared secret: set the SAME
# value on backend and frontend; the frontend sends it server-side in the
# X-API-Key header. Empty = auth disabled (fine for local dev).
RAG_API_KEY=
# Hard cap on total cost-incurring calls per UTC day (503 once spent). The
# per-IP limits below have sensible defaults; override only to tune.
API_DAILY_BUDGET=500
# API_RATE_LIMIT=20      # sustained per-IP requests ...
# API_RATE_WINDOW=3600   # ... per this many seconds
# API_BURST_LIMIT=5      # burst per-IP requests ...
# API_BURST_WINDOW=60    # ... per this many seconds
# API_PAUSED=false       # set true to 503 the paid endpoints (maintenance)

# --- Frontend ---------------------------------------------------------------
RAG_API_URL=https://rag-backend.onrender.com
# Same secret as the backend's RAG_API_KEY above (the frontend authenticates
# to the backend with it). Leave empty only if the backend has auth disabled.
RAG_API_KEY=
